APP_NAME=星云智家售后服务智能体
ENVIRONMENT=development
SECRET_KEY=change-me-before-production-at-least-32-bytes
JWT_ISSUER=nebula-business-service
JWT_AUDIENCE=nebula-platform
API_PREFIX=/api/ai/v1
ENABLE_LEGACY_API=true
DATABASE_URL=sqlite:///./aftersales.db
REDIS_URL=redis://localhost:6379/0
JOB_DATA_DIR=./data/jobs
JOB_LEASE_SECONDS=120
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
BUSINESS_SERVICE_ENABLED=false
BUSINESS_SERVICE_URL=http://localhost:8080
BUSINESS_SERVICE_TIMEOUT_SECONDS=5
# Optional in local development (blank disables service-token issuance).
# Production Compose requires a newly generated private value.
BUSINESS_SERVICE_CREDENTIAL=
AGENT_MAX_STEPS=24
CONVERSATION_SUMMARY_THRESHOLD=24
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_PROVIDER=hash
MODEL_CACHE_DIR=./.model-cache
MODEL_OFFLINE=false
EMBEDDING_DEVICE=cpu
# Optional Docker build mirror, useful on slow networks.
PIP_INDEX_URL=https://pypi.org/simple
MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21
JAVA_IMAGE=eclipse-temurin:21-jre
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
LIGHTRAG_BASE_URL=
LIGHTRAG_API_KEY=
OPENVIKING_BASE_URL=
OPENVIKING_API_KEY=
OPENVIKING_ROOT_URI=viking://resources/aftersales
EXTERNAL_RETRIEVAL_TIMEOUT_SECONDS=30
MEM0_BASE_URL=
MEM0_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Docker Compose uses these separately because localhost inside a container is
# not the Windows host. Set COMPOSE_OLLAMA_BASE_URL=http://ollama:11434 when
# starting the local-model profile.
POSTGRES_PASSWORD=change-me-before-shared-deployment
BIZ_DB_PASSWORD=change-me-biz-database-password
AI_DB_PASSWORD=change-me-ai-database-password
COMPOSE_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BUSINESS_HOST_PORT=8080
AI_HOST_PORT=8000
WEB_HOST_PORT=5173
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434

