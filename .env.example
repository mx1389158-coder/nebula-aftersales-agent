APP_NAME=星云智家售后服务智能体
ENVIRONMENT=development
SECRET_KEY=change-me-before-production-at-least-32-bytes
DATABASE_URL=sqlite:///./aftersales.db
REDIS_URL=redis://localhost:6379/0
JOB_DATA_DIR=./data/jobs
JOB_LEASE_SECONDS=120
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_PROVIDER=hash
MODEL_CACHE_DIR=./.model-cache
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
LIGHTRAG_BASE_URL=
LIGHTRAG_API_KEY=
OPENVIKING_BASE_URL=
OPENVIKING_API_KEY=
OPENVIKING_ROOT_URI=viking://resources/aftersales
EXTERNAL_RETRIEVAL_TIMEOUT_SECONDS=30
MEM0_BASE_URL=
MEM0_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Docker Compose uses these separately because localhost inside a container is
# not the Windows host. Set COMPOSE_OLLAMA_BASE_URL=http://ollama:11434 when
# starting the local-model profile.
POSTGRES_PASSWORD=change-me-before-shared-deployment
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434

